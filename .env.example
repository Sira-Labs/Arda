# Local development. Copy to `.env` (never committed) or export the variables in your shell.
# Production values live in CapRover's app settings; see docs/ops/caprover-deployment.md.

# --- apps/api ---------------------------------------------------------------------------
ARDA_ENV=dev
ARDA_DATABASE_URL=postgres://arda:arda-dev-password-0001@127.0.0.1:5432/arda
# At least 32 random characters: `openssl rand -hex 32`
ARDA_AUTH_SECRET=
ARDA_PUBLIC_URL=http://localhost:5173
# Without SMTP outside prod, the sign-in link and code are written to the api log.
# ARDA_SMTP_HOST=smtp-relay.gmail.com
# ARDA_SMTP_PORT=587
# ARDA_MAIL_FROM="ʿArḍa <noreply@example.org>"

# --- apps/web ---------------------------------------------------------------------------
# The Vite dev server proxies /api to this address.
# ARDA_API_URL=http://localhost:8000
